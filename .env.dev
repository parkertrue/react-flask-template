# Local development. Committed on purpose: these throwaway values only reach
# MySQL and Redis in docker-compose.dev.yml, which publish on 127.0.0.1 alone.
# Never reuse them anywhere else. To run without the debugger for one session:
#   FLASK_DEBUG=0 ./run_dev.sh

# Hosts are 127.0.0.1, not localhost: the compose services publish on IPv4
# only, and where localhost resolves to ::1 first (Windows), every new
# connection waits ~2s for that attempt to fail.

# Database: the app's user reads and writes rows; the migration user owns
# the schema (the MySQL image creates the migration user,
# db/init/01-app-user.sh the app's)
DB_NAME=appdb_dev
DB_USER=app
DB_PASSWORD=devpass
DB_MIGRATION_USER=app_migrate
DB_MIGRATION_PASSWORD=devmigratepass
DB_ROOT_PASSWORD=devrootpass

# Flask
APP_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-not-for-production-0123456789

# Redis: the app's user, and the worker's, which reaches the job queue alone
REDIS_PASSWORD=devredispass
REDIS_WORKER_PASSWORD=devredisworkerpass

# Email, which the worker sends to Mailpit (docker-compose.dev.yml): read it
# at http://localhost:8025
EMAIL_URL=smtp://127.0.0.1:1025
EMAIL_FROM="App <no-reply@app.localhost>"

# What the app reads, built from the values above. run_dev.sh migrates with
# MIGRATION_DATABASE_URL, then starts the app without it.
DATABASE_URL=mysql+pymysql://${DB_USER}:${DB_PASSWORD}@127.0.0.1:3306/${DB_NAME}
MIGRATION_DATABASE_URL=mysql+pymysql://${DB_MIGRATION_USER}:${DB_MIGRATION_PASSWORD}@127.0.0.1:3306/${DB_NAME}
REDIS_URL=redis://app:${REDIS_PASSWORD}@127.0.0.1:6379/0
# run_dev.sh starts the worker with this as its REDIS_URL
REDIS_WORKER_URL=redis://worker:${REDIS_WORKER_PASSWORD}@127.0.0.1:6379/0
