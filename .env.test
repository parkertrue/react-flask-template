# Integration and E2E tests. Committed on purpose: these throwaway values live
# only as long as a test run. Ports match docker-compose.test.yml, whose E2E
# backend container sets its own hosts and ports for the Docker network.

# Hosts are 127.0.0.1, not localhost: the compose services publish on IPv4
# only, and where localhost resolves to ::1 first (Windows), every new
# connection waits ~2s for that attempt to fail.

# Database: the app's user reads and writes rows; the migration user owns
# the schema (db/init/01-app-user.sh creates both)
DB_NAME=appdb_test
DB_USER=app
DB_PASSWORD=testpass
DB_MIGRATION_USER=app_migrate
DB_MIGRATION_PASSWORD=testmigratepass
DB_ROOT_PASSWORD=testrootpass

# Flask
APP_ENV=integration
SECRET_KEY=test-secret-key-for-ci-only-0123456789

# Redis
REDIS_PASSWORD=testredispass

# What the integration suite reads, built from the values above. It connects
# as the migration user, since its fixtures create and drop the tables.
DATABASE_URL=mysql+pymysql://${DB_USER}:${DB_PASSWORD}@127.0.0.1:3307/${DB_NAME}
MIGRATION_DATABASE_URL=mysql+pymysql://${DB_MIGRATION_USER}:${DB_MIGRATION_PASSWORD}@127.0.0.1:3307/${DB_NAME}
REDIS_URL=redis://app:${REDIS_PASSWORD}@127.0.0.1:6380/0
