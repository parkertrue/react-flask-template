# Build context of backend/Dockerfile, which copies all of it. Unlike
# .gitignore, a pattern here matches only at the context root unless it
# starts with **/.

# Python
**/__pycache__/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Tests
tests/
pytest.ini
.coveragerc

# Dev Scripts
run_dev.sh
run_tests.sh
lock_deps.sh
requirements.in
requirements-dev.in
requirements-dev.txt
ruff.toml
mypy.ini
