# Runtime dependencies the backend's code imports directly, even those another
# package brings along (tests/unit/test_requirements.py checks the list).
# requirements.txt is the lock compiled from this file: every package,
# transitive ones included, pinned to an exact version, so each image build
# installs exactly what was tested.
# After editing this file, regenerate the lock (backend/lock_deps.sh; README, "Python Dependencies").

# Required by PyMySQL for MySQL 8's default caching_sha2_password auth
cryptography
gunicorn
Flask
Werkzeug
Flask-JWT-Extended
PyJWT
Flask-Limiter
Flask-Migrate
alembic
Flask-SQLAlchemy
SQLAlchemy
redis
pydantic
email-validator
# The driver DATABASE_URL names (mysql+pymysql://), loaded by SQLAlchemy
PyMySQL
