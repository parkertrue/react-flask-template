# Test and lint tooling, compiled into requirements-dev.txt on top of the
# runtime lock: the constraint keeps every shared package at the version
# production runs.
-c requirements.txt
-r requirements.in

pytest
pytest-cov
# Runs the tests in a new order every time (the seed is in the header), so
# one test leaning on another's leftovers fails at once
pytest-randomly
ruff
# Type checks app/ in strict mode (mypy.ini); the pydantic plugin it loads
# comes with pydantic
mypy
