# Production: copy to .env.prod (gitignored) and replace every value. Not
# named plain .env on purpose: Compose reads a .env in the project directory
# automatically, so production values would leak into every dev and test
# command.
# Hosts, ports and APP_ENV are fixed in docker-compose.yml; this file holds
# only what differs per deployment. ProductionConfig refuses a SECRET_KEY
# shorter than 32 characters or left at its placeholder, and the placeholder
# passwords below. The DB
# values apply only when the database volume is first created; to change one
# later, see README, Environment Files. Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Database
DB_NAME=appdb
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here
DB_ROOT_PASSWORD=your_root_password_here

# Redis
REDIS_PASSWORD=your_redis_password_here

# Flask
SECRET_KEY=your_secret_key_here

# Nginx: the domain(s) to serve, space-separated (localhost to test locally).
# Requests for any other host name or a bare IP are dropped.
SERVER_NAME=yourdomain.com www.yourdomain.com
