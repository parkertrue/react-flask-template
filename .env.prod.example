# Production: copy to .env.prod (gitignored) and replace every value. Not
# named plain .env on purpose: Compose reads a .env in the project directory
# automatically, so production values would leak into every dev and test
# command.
# Hosts, ports and APP_ENV are fixed in docker-compose.yml; this file holds
# only what differs per deployment. ProductionConfig refuses a SECRET_KEY
# shorter than 32 characters or left at its placeholder, and the placeholder
# passwords below; the database refuses its own on first start. The DB
# values apply only when the database volume is first created; to change one
# later, see docs/deployment.md, Changing a Value Later. Generate each secret with:
#   openssl rand -hex 32

# The bundled MySQL and Redis containers. To use an external database or
# Redis (a managed service), remove its profile here and set its URLs below
# instead: DATABASE_URL and MIGRATION_DATABASE_URL, or REDIS_URL. Production
# reaches an external host only over TLS (docs/deployment.md, External
# Database or Redis). Its bundled values below are then unused; Compose warns if they
# are removed.
COMPOSE_PROFILES=bundled-db,bundled-redis

# Database. Two users, created with the database volume (the MySQL image
# makes the migration user, db/init/01-app-user.sh the app's): the app's,
# which may only read and write rows, and the migration user, which owns the
# schema and only the one-off migrate service gets. Only the db container
# gets the root password.
DB_NAME=appdb
DB_USER=your_db_user_here
DB_PASSWORD=your_db_password_here
DB_MIGRATION_USER=your_migration_user_here
DB_MIGRATION_PASSWORD=your_migration_password_here
DB_ROOT_PASSWORD=your_root_password_here

# Redis: the app's user, and the worker's, which may touch only the job queue
REDIS_PASSWORD=your_redis_password_here
REDIS_WORKER_PASSWORD=your_redis_worker_password_here

# Email, which the worker sends through your mail provider's SMTP server
# (docs/deployment.md, Sending Email). smtps:// is TLS from the start (port
# 465 by default), smtp+starttls:// upgrades to it (587); production refuses
# anything else. Percent-encode any @, : or / in the user or password.
EMAIL_URL=smtps://your_smtp_user:your_smtp_password_here@smtp.example.com
# The sender, an address on a domain set up with your provider
EMAIL_FROM="App <no-reply@example.com>"

# Flask
SECRET_KEY=your_secret_key_here

# Nginx: the domain(s) to serve, space-separated (localhost to test locally).
# Requests for any other host name or a bare IP are dropped.
SERVER_NAME=yourdomain.com www.yourdomain.com

# External services (see COMPOSE_PROFILES above). Each replaces the URL that
# docker-compose.yml builds from the bundled values.
# DATABASE_URL=mysql+pymysql://app:<password>@<host>:3306/appdb?ssl_ca=<CA bundle path>
# MIGRATION_DATABASE_URL=mysql+pymysql://app_migrate:<password>@<host>:3306/appdb?ssl_ca=<CA bundle path>
# REDIS_URL=rediss://app:<password>@<host>:6379/0
# REDIS_WORKER_URL=rediss://worker:<password>@<host>:6379/0

# Where emailed links point, if not https:// and the first name in
# SERVER_NAME
# APP_URL=https://www.yourdomain.com
