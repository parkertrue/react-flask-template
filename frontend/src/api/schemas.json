{
  "$defs": {
    "AccountDeleteRequest": {
      "additionalProperties": false,
      "description": "POST /api/account/delete: the account's password, typed again",
      "properties": {
        "password": {
          "maxLength": 128,
          "minLength": 15,
          "type": "string"
        }
      },
      "required": [
        "password"
      ],
      "title": "AccountDeleteRequest",
      "type": "object"
    },
    "AccountExport": {
      "description": "The account's own row in an export, without its password hash",
      "properties": {
        "created_at": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "terms_accepted_at": {
          "type": "string"
        },
        "terms_version": {
          "type": "integer"
        }
      },
      "required": [
        "email",
        "created_at",
        "terms_version",
        "terms_accepted_at"
      ],
      "title": "AccountExport",
      "type": "object"
    },
    "AccountResponse": {
      "description": "GET /api/account: the signed-in user's own account",
      "properties": {
        "created_at": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      },
      "required": [
        "email",
        "created_at"
      ],
      "title": "AccountResponse",
      "type": "object"
    },
    "DataExportResponse": {
      "description": "GET /api/account/export: everything the app keeps on the signed-in\nuser. data holds each feature's rows under its name (utils/exports.py).",
      "properties": {
        "account": {
          "$ref": "#/$defs/AccountExport"
        },
        "data": {
          "additionalProperties": {
            "items": {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            "type": "array"
          },
          "type": "object"
        },
        "exported_at": {
          "type": "string"
        }
      },
      "required": [
        "exported_at",
        "account",
        "data"
      ],
      "title": "DataExportResponse",
      "type": "object"
    },
    "EmailChangeRequest": {
      "additionalProperties": false,
      "description": "POST /api/account/email: the address to move the account to, and the\naccount's password, typed again",
      "properties": {
        "email": {
          "type": "string"
        },
        "password": {
          "maxLength": 128,
          "minLength": 15,
          "type": "string"
        }
      },
      "required": [
        "email",
        "password"
      ],
      "title": "EmailChangeRequest",
      "type": "object"
    },
    "EmailChangedResponse": {
      "description": "The account's address once a link has moved it",
      "properties": {
        "email": {
          "type": "string"
        }
      },
      "required": [
        "email"
      ],
      "title": "EmailChangedResponse",
      "type": "object"
    },
    "EmailLinkRequest": {
      "additionalProperties": false,
      "description": "An email change's emailed link, posted by its page: the one that moves\nthe account to the new address, or the one that moves it back",
      "properties": {
        "token": {
          "maxLength": 1024,
          "type": "string"
        }
      },
      "required": [
        "token"
      ],
      "title": "EmailLinkRequest",
      "type": "object"
    },
    "HealthResponse": {
      "description": "GET /api/health: \"ok\" whenever the backend answers",
      "properties": {
        "status": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "HealthResponse",
      "type": "object"
    },
    "JsonValue": {},
    "LoginRequest": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "type": "string"
        },
        "password": {
          "maxLength": 128,
          "minLength": 15,
          "type": "string"
        }
      },
      "required": [
        "email",
        "password"
      ],
      "title": "LoginRequest",
      "type": "object"
    },
    "MessageResponse": {
      "description": "A reply that only says what happened: a link sent, logged out, ...",
      "properties": {
        "message": {
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "title": "MessageResponse",
      "type": "object"
    },
    "NoteCreateRequest": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "content"
      ],
      "title": "NoteCreateRequest",
      "type": "object"
    },
    "NoteResponse": {
      "properties": {
        "content": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "id": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "content",
        "created_at"
      ],
      "title": "NoteResponse",
      "type": "object"
    },
    "NoteUpdateRequest": {
      "additionalProperties": false,
      "description": "PUT /api/notes/<id>: the note's new content, under the same rules",
      "properties": {
        "content": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "content"
      ],
      "title": "NoteUpdateRequest",
      "type": "object"
    },
    "NotesListQuery": {
      "additionalProperties": false,
      "description": "GET /api/notes query string: ?before=<next_cursor>&limit=<n>",
      "properties": {
        "before": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        }
      },
      "title": "NotesListQuery",
      "type": "object"
    },
    "NotesPageResponse": {
      "description": "GET /api/notes: one page, newest first. next_cursor fetches the page\nafter it (?before=), and is null on the last page.",
      "properties": {
        "next_cursor": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "items": {
            "$ref": "#/$defs/NoteResponse"
          },
          "type": "array"
        }
      },
      "required": [
        "notes",
        "next_cursor"
      ],
      "title": "NotesPageResponse",
      "type": "object"
    },
    "PasswordChangeRequest": {
      "additionalProperties": false,
      "description": "POST /api/account/password: the account's password, typed again, and\nthe one to replace it",
      "properties": {
        "current_password": {
          "maxLength": 128,
          "minLength": 15,
          "type": "string"
        },
        "new_password": {
          "maxLength": 128,
          "minLength": 15,
          "type": "string"
        }
      },
      "required": [
        "current_password",
        "new_password"
      ],
      "title": "PasswordChangeRequest",
      "type": "object"
    },
    "PasswordResetCompleteRequest": {
      "additionalProperties": false,
      "description": "A password reset's second step, from the emailed link's page",
      "properties": {
        "password": {
          "maxLength": 128,
          "minLength": 15,
          "type": "string"
        },
        "token": {
          "maxLength": 1024,
          "type": "string"
        }
      },
      "required": [
        "token",
        "password"
      ],
      "title": "PasswordResetCompleteRequest",
      "type": "object"
    },
    "PasswordResetRequest": {
      "additionalProperties": false,
      "description": "A password reset's first step: the account's address, to email a\nlink to",
      "properties": {
        "email": {
          "type": "string"
        }
      },
      "required": [
        "email"
      ],
      "title": "PasswordResetRequest",
      "type": "object"
    },
    "RegisterCompleteRequest": {
      "additionalProperties": false,
      "description": "Sign-up's second step, from the emailed link's page",
      "properties": {
        "password": {
          "maxLength": 128,
          "minLength": 15,
          "type": "string"
        },
        "terms_version": {
          "type": "integer"
        },
        "token": {
          "maxLength": 1024,
          "type": "string"
        }
      },
      "required": [
        "token",
        "password",
        "terms_version"
      ],
      "title": "RegisterCompleteRequest",
      "type": "object"
    },
    "RegisterCompleteResponse": {
      "description": "Sign-up's login, and the account's address: the token's, which the\npage signs in under, never anything else the link carried",
      "properties": {
        "access_token": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "refresh_csrf": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "access_token",
        "email"
      ],
      "title": "RegisterCompleteResponse",
      "type": "object"
    },
    "RegisterRequest": {
      "additionalProperties": false,
      "description": "Sign-up's first step: the address to send the link to",
      "properties": {
        "email": {
          "type": "string"
        }
      },
      "required": [
        "email"
      ],
      "title": "RegisterRequest",
      "type": "object"
    },
    "TokensResponse": {
      "description": "A login's or refresh's new access token, and the CSRF value of the\nrefresh token set in the cookie (none when CSRF protection is off)",
      "properties": {
        "access_token": {
          "type": "string"
        },
        "refresh_csrf": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "access_token"
      ],
      "title": "TokensResponse",
      "type": "object"
    }
  }
}
